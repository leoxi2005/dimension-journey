<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Kinect SDK 2.0 chỉ chạy trên .NET Framework, không phải .NET Core/5+. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>KinectBridge</AssemblyName>
    <RootNamespace>KinectBridge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <!-- Đường dẫn mặc định khi cài Kinect for Windows SDK 2.0. Sửa lại nếu bạn
         cài chỗ khác. -->
    <Reference Include="Microsoft.Kinect">
      <HintPath>C:\Program Files\Microsoft SDKs\Kinect\v2.0_1409\Assemblies\Microsoft.Kinect.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
